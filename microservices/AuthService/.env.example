NODE_ENV=production
PORT=3001

# Railway MySQL reference variables.
DB_HOST=${{ MySQL.MYSQLHOST }}
DB_PORT=${{ MySQL.MYSQLPORT }}
DB_USER=${{ MySQL.MYSQLUSER }}
DB_PASSWORD=${{ MySQL.MYSQLPASSWORD }}
DB_NAME=auth_db_vet
DB_CONNECTION_LIMIT=10

# Must match API Gateway ACCESS_TOKEN_SECRET.
ACCESS_TOKEN_SECRET=VHpRHPBPSolmmoCJ5QrHqB9TyhC7vjzVbKzb3mSZCJrV44IzAjs0jjitBdmocw7X
REFRESH_TOKEN_SECRET=KLMrsK0eQUk5Qyp4paohGmH1kgzG8g0FvHHTSmaLAVIXoVdYO9IqSx7sxs4CpoSq

# Comma-separated frontend/admin origins allowed to call AuthService directly.
CORS_ALLOWED_ORIGINS=https://vetcare-admin-dashboard.vercel.app,https://reset-password-vetcare.vercel.app,http://localhost:8081,http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used in reset-password email links.
CLIENT_URL=https://reset-password-vetcare.vercel.app

# Gmail SMTP. Use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-google-app-password

# Optional production email API. If set in production, AuthService sends mail through EmailJS HTTPS instead of SMTP.
EMAILJS_SERVICE_ID=service_ehits4n
EMAILJS_TEMPLATE_ID=template_fegmr68
EMAILJS_PUBLIC_KEY=H3mxl8MH-e7ZSaaV0
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
