NODE_ENV=production
PORT=3001

# Railway MySQL reference variables.
DB_HOST=${{ MySQL.MYSQLHOST }}
DB_PORT=${{ MySQL.MYSQLPORT }}
DB_USER=${{ MySQL.MYSQLUSER }}
DB_PASSWORD=${{ MySQL.MYSQLPASSWORD }}
DB_NAME=auth_db_vet
DB_CONNECTION_LIMIT=10

# Must match API Gateway ACCESS_TOKEN_SECRET.
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_token_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_refresh_token_secret

# Comma-separated frontend/admin origins allowed to call AuthService directly.
CORS_ALLOWED_ORIGINS=https://your-admin-dashboard.vercel.app,https://your-mobile-or-web-client.example.com

# Frontend URL used in reset-password email links.
CLIENT_URL=https://your-admin-dashboard.vercel.app

# Gmail SMTP. Use a Google App Password, not your normal Gmail password.
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
