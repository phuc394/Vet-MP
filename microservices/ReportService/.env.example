NODE_ENV=production
PORT=3007

# Railway MySQL reference variables.
DB_HOST=${{ MySQL.MYSQLHOST }}
DB_PORT=${{ MySQL.MYSQLPORT }}
DB_USER=${{ MySQL.MYSQLUSER }}
DB_PASSWORD=${{ MySQL.MYSQLPASSWORD }}
DB_CONNECTION_LIMIT=10

# ReportService reads across all service databases.
DB_AUTH_NAME=auth_db_vet
DB_PET_NAME=pet_db_vet
DB_CATALOG_NAME=catalog_db_vet
DB_INVENTORY_NAME=inventory_db_vet
DB_APPOINTMENT_NAME=appointment_db_vet
DB_MEDICAL_RECORD_NAME=medical_record_db_vet
